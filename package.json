{
  "name": "ImageOverlayTool",
  "description": "image blend tool",
  "version": "0.1.0",
  "license": "NO License",
  "author": "yuhomori",
  "main": "dist/main.js",
  "scripts": {
    "predev": "rimraf dist",
    "dev": "run-p dev:*",
    "dev:tsc": "tsc -w -p tsconfig.main.json",
    "dev:webpack": "cross-env NODE_ENV=\"development\" webpack --progress",
    "dev:electron": "wait-on ./dist/index.html ./dist/main.js && cross-env NODE_ENV=\"development\" electron .",
    "build": "cross-env NODE_ENV=\"production\" webpack --progress",
    "package": "ts-node ./builder.ts",
    "compile": "tsc -p tsconfig.main.json && cross-env NODE_ENV=\"development\" NO_WATCH=\"true\" webpack",
    "lint-fix": "eslint --cache --fix src/ && prettier --write src/"
  },
  "dependencies": {
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@hello-pangea/dnd": "^16.0.0",
    "@mui/icons-material": "^5.10.3",
    "@mui/material": "^5.10.3",
    "@reduxjs/toolkit": "^1.8.5",
    "@types/react-color": "^3.0.6",
    "array-move": "^4.0.0",
    "electron-store": "^8.1.0",
    "i18next": "^21.9.1",
    "konva": "^8.3.12",
    "react": "^18.2.0",
    "react-color": "^2.19.3",
    "react-dom": "^18.2.0",
    "react-i18next": "^11.18.5",
    "react-konva": "^18.2.1",
    "react-redux": "^8.0.2",
    "redux": "^4.2.0",
    "use-callback-ref": "^1.3.0",
    "use-image": "^1.0.12",
    "uuidjs": "^4.2.11",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@types/node": "^18.7.11",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.36.0",
    "@typescript-eslint/parser": "^5.36.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.1",
    "electron": "^20.0.3",
    "electron-builder": "^23.3.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^8.23.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.31.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.6.1",
    "npm-run-all": "^4.1.5",
    "perspectivets": "^2.0.0",
    "prettier": "^2.7.1",
    "react-konva-utils": "^0.3.0",
    "rimraf": "^3.0.2",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.7.4",
    "wait-on": "^6.0.1",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-license-plugin": "^4.2.2"
  }
}
