{
  "name": "imageoverlaytool",
  "description": "image blend tool",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "yuhomori",
    "email": "morimo07+github@outlook.jp"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch --inspect=9229",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "generate-licenses": "node scripts/generate-licenses.js",
    "build:win": "npm run generate-licenses && npm run build && electron-builder --win",
    "build:linux": "npm run generate-licenses && npm run build && electron-builder --linux",
    "build:all": "npm run generate-licenses && npm run build && electron-builder --win --linux",
    "preview": "electron-vite preview",
    "lint:fix": "eslint --cache --fix src/ && prettier --write src/",
    "test": "vitest run --reporter=verbose --exclude \"**/e2e/**\" --exclude \"**/node_modules/**\"",
    "test:watch": "vitest",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/startup.spec.ts"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "array-move": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "i18next": "^24.0.0",
    "konva": "^8.3.12",
    "lucide-react": "^0.562.0",
    "perspectivets": "^2.0.0",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.2.0",
    "react-konva": "^19.0.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "use-image": "^1.0.12",
    "uuidjs": "^4.2.11",
    "zundo": "^2.3.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.19.27",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^40.1.0",
    "electron-builder": "^23.3.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^8.23.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.31.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^20.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "license-checker": "^25.0.1",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^2.7.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,html}": [
      "prettier --write"
    ]
  }
}
