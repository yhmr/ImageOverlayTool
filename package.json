{
  "name": "imageoverlaytool",
  "description": "image blend tool",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "author": "yuhomori",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch --inspect=9229",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder --win --linux",
    "preview": "electron-vite preview",
    "lint-fix": "eslint --cache --fix src/ && prettier --write src/",
    "test": "vitest run --reporter=verbose --exclude \"**/e2e/**\" --exclude \"**/node_modules/**\"",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@hello-pangea/dnd": "^16.0.0",
    "@mui/icons-material": "^5.10.3",
    "@mui/material": "^5.10.3",
    "array-move": "^4.0.0",
    "electron-store": "^8.1.0",
    "i18next": "^21.9.1",
    "konva": "^8.3.12",
    "perspectivets": "^2.0.0",
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "react-i18next": "^11.18.5",
    "react-konva": "^18.2.1",
    "redux": "^4.2.0",
    "use-image": "^1.0.12",
    "uuidjs": "^4.2.11",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.19.27",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.36.0",
    "@typescript-eslint/parser": "^5.36.0",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^28.0.0",
    "electron-builder": "^23.3.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^8.23.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.31.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^20.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^2.7.1",
    "typescript": "^4.7.4",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,html}": [
      "prettier --write"
    ]
  }
}