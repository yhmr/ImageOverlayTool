{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:react/recommended",
        "plugin:@typescript-eslint/recommended",
        "prettier"
    ],
    "overrides": [
        {
            "files": [
                "*.test.ts",
                "*.test.tsx"
            ],
            "rules": {
                "@typescript-eslint/no-explicit-any": "off"
            }
        },
        {
            "files": [
                "**/ImageStage.tsx",
                "**/PerspectiveImage.tsx",
                "**/OverlayControls.tsx",
                "**/DimensionLineLayer.tsx"
            ],
            "rules": {
                "react-compiler/react-compiler": "off"
            }
        },
        {
            "files": [
                "src/renderer/main-window/**/*.tsx",
                "src/renderer/image-settings/**/*.tsx"
            ],
            "excludedFiles": [
                "src/renderer/main-window/components/ImageStage.tsx",
                "src/renderer/main-window/components/PerspectiveImage.tsx",
                "src/renderer/main-window/components/OverlayControls.tsx",
                "src/renderer/main-window/components/DimensionLineLayer.tsx",
                "src/renderer/main-window/components/DrawImage.tsx"
            ],
            "rules": {
                "require-component-testid": "warn"
            }
        }
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "react",
        "@typescript-eslint",
        "react-hooks",
        "react-compiler"
    ],
    "rules": {
        "react-compiler/react-compiler": "error",
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "warn",
        "react/react-in-jsx-scope": "off",
        "require-data-testid": "warn"
    },
    "settings": {
        "react": {
            "version": "detect"
        }
    }
}
